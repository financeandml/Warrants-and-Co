# ============================================================================
# Warrants & Co. — plantilla de variables de entorno
#
# Copie este fichero a `.env`, ponga sus valores y arranque con:
#
#     node --env-file=.env server.js
#
# `--env-file` es de Node y no necesita ninguna dependencia. Requiere Node
# 20.6 o superior; el proyecto ya exige 22.5.
#
# ESTE fichero (.env.example) SÍ se versiona: es la lista de lo que hace falta.
# El fichero `.env` con los valores reales NO: `.gitignore` lo excluye.
# ============================================================================


# ─── Obligatoria ───────────────────────────────────────────────────────────

# Credencial del área de analistas: da de alta y modifica informes.
# NO tiene valor por defecto y el servidor NO ARRANCA sin ella. Antes había uno
# escrito en `server.js`, que es lo mismo que publicarla: quedaba en el
# repositorio y en su historial. Genere la suya y no la comparta:
#
#     openssl rand -base64 24
#
WARRANTS_CLAVE=


# ─── Red ───────────────────────────────────────────────────────────────────

PORT=4173
# 127.0.0.1 solo admite conexiones de esta máquina. Ponga 0.0.0.0 únicamente si
# sabe que quiere exponer el servicio a la red.
HOST=127.0.0.1

# Peticiones por IP y minuto sobre /api. Las baterías necesitan subirlo: una
# pasada abre medio centenar de peticiones en segundos.
WARRANTS_MAX_PETICIONES=300


# ─── Rutas de datos ────────────────────────────────────────────────────────
# Apunte estas tres a un directorio aparte para cualquier prueba que escriba.
# Vease «Pruebas que escriben» en CLAUDE.md.

WARRANTS_DB=data/warrants.db
WARRANTS_UPLOADS=data/uploads
WARRANTS_COPIAS=data/copias


# ─── Datos de mercado ──────────────────────────────────────────────────────

# Vigencia de la cache de cotizaciones. El cliente sondea la cinta cada 20 s,
# por encima de este valor: pedir mas a menudo no traeria un dato mas nuevo.
TTL_COTIZACION_MS=15000
TTL_HISTORICO_MS=1800000


# ─── Noticias ──────────────────────────────────────────────────────────────

INTERVALO_NOTICIAS_MS=900000
RETENCION_NOTICIAS_DIAS=60
# false desactiva la sindicacion automatica.
NOTICIAS_AUTOMATICAS=true


# ─── Opciones ──────────────────────────────────────────────────────────────

OPCIONES_PROVEEDOR=nasdaq
TTL_OPCIONES_MS=300000
RETENCION_OPCIONES_DIAS=180

# Credencial del proveedor ThetaData. Opcional: sin ella ese proveedor no se
# usa. Es la SEGUNDA credencial del proyecto — tratela como la primera.
THETADATA_CLAVE=
