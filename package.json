    "test:idiomas": "node tests/idiomas.js",
    "test:errores": "node tests/errores.js",
    "test:mercado-idiomas": "node tests/mercado-idiomas.js",
    "test:repintado": "node tests/repintado.js",
    "test:portada": "node tests/portada.js",
    "test:derivadas": "node tests/derivadas.js",
    "test:extraccion": "node tests/extraccion.js",
    "test:extraccion-lector": "node tests/extraccion-lector.js",
    "test:extraccion-rotulos": "node tests/extraccion-rotulos.js",
    "test:extraccion-corpus": "node tests/extraccion-corpus.js",
    "test:propuesta": "node tests/propuesta.js",
